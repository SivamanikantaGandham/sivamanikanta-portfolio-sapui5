<mvc:View
	controllerName="sivamanikanta.portfolio.controller.Skills"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	height="100%">
	<Page id="skillsPage" showHeader="false" class="portfolioPage">
		<content>
			<core:Fragment fragmentName="sivamanikanta.portfolio.view.NavBar" type="XML"/>

			<!-- ===== Skills ===== -->
			<VBox id="skills" class="section">
				<Title text="{i18n>sectionSkills}" level="H2" class="sectionTitle"/>
				<VBox items="{path: 'portfolio>/skillCategories', templateShareable: false}" class="skillCategoryList">
					<Panel headerText="{portfolio>name}" class="skillPanel">
						<FlexBox wrap="Wrap" items="{path: 'portfolio>skills', templateShareable: false}">
							<ObjectStatus text="{portfolio>name}" tooltip="{portfolio>desc}" class="skillChip"/>
						</FlexBox>
					</Panel>
				</VBox>
			</VBox>
		</content>
	</Page>
</mvc:View>