<mvc:View
	controllerName="sivamanikanta.portfolio.controller.About"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout"
	height="100%">
	<Page id="aboutPage" showHeader="false" class="portfolioPage">
		<content>
			<core:Fragment fragmentName="sivamanikanta.portfolio.view.NavBar" type="XML"/>

			<!-- ===== About / Stats ===== -->
			<VBox id="about" class="section">
				<Title text="{i18n>sectionAbout}" level="H2" class="sectionTitle"/>
				<l:Grid defaultSpan="L3 M6 S12" class="statsGrid" content="{path: 'portfolio>/stats', templateShareable: false}">
					<VBox class="statTile">
						<Title text="{portfolio>value}" level="H2" class="statValue"/>
						<Text text="{portfolio>label}" class="statLabel"/>
					</VBox>
				</l:Grid>
			</VBox>
		</content>
	</Page>
</mvc:View>