<mvc:View
	controllerName="sivamanikanta.portfolio.controller.WhyMe"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout"
	height="100%">
	<Page id="whyMePage" showHeader="false" class="portfolioPage">
		<content>
			<core:Fragment fragmentName="sivamanikanta.portfolio.view.NavBar" type="XML"/>

			<!-- ===== Why work with me ===== -->
			<VBox id="whyMe" class="section">
				<Title text="{i18n>sectionWhyMe}" level="H2" class="sectionTitle"/>
				<l:Grid defaultSpan="L4 M6 S12" class="whyMeGrid" content="{path: 'portfolio>/whyMe', templateShareable: false}">
					<VBox class="whyMeCard">
						<core:Icon src="{portfolio>icon}" class="whyMeIcon" size="2rem"/>
						<Title text="{portfolio>title}" level="H5" class="whyMeTitle"/>
						<Text text="{portfolio>desc}" class="whyMeDesc" wrapping="true"/>
					</VBox>
				</l:Grid>
			</VBox>
		</content>
	</Page>
</mvc:View>
