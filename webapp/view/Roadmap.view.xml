<mvc:View
	controllerName="sivamanikanta.portfolio.controller.Roadmap"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	height="100%">
	<Page id="roadmapPage" showHeader="false" class="portfolioPage">
		<content>
			<core:Fragment fragmentName="sivamanikanta.portfolio.view.NavBar" type="XML"/>

			<!-- ===== Roadmap ===== -->
			<VBox id="roadmap" class="section">
				<Title text="{i18n>sectionRoadmap}" level="H2" class="sectionTitle"/>
				<ScrollContainer horizontal="true" showHorizontalScrollbar="false" class="roadmapScroller">
					<HBox items="{path: 'portfolio>/roadmap', templateShareable: false}" class="roadmapFlow">
						<VBox class="roadmapStep" alignItems="Center">
							<VBox class="roadmapNode" alignItems="Center" justifyContent="Center">
								<Text text="{portfolio>year}" class="roadmapYear"/>
							</VBox>
							<Text text="{portfolio>label}" class="roadmapLabel"/>
						</VBox>
					</HBox>
				</ScrollContainer>
			</VBox>
		</content>
	</Page>
</mvc:View>
