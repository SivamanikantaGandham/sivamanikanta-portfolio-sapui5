<mvc:View
	controllerName="sivamanikanta.portfolio.controller.Contact"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	height="100%">
	<Page id="contactPage" showHeader="false" class="portfolioPage">
		<content>
			<core:Fragment fragmentName="sivamanikanta.portfolio.view.NavBar" type="XML"/>

			<!-- ===== Contact ===== -->
			<VBox id="contact" class="section contactSection" alignItems="Center">
				<Title text="{i18n>sectionContact}" level="H2" class="sectionTitle"/>
				<Text text="{portfolio>/contact/location} · {portfolio>/contact/openTo}" class="contactLocation"/>
				<HBox class="contactActions" wrap="Wrap" justifyContent="Center">
					<Button text="{i18n>btnEmail}" type="Emphasized" press="onEmail"/>
					<Button text="{i18n>btnCall}" type="Ghost" press="onCall"/>
					<Button text="{i18n>btnLinkedIn}" type="Ghost" press="onOpenLinkedIn"/>
					<Button text="{i18n>btnInstagram}" type="Ghost" press="onOpenInstagram"/>
					<Button text="{i18n>btnDownloadResume}" type="Ghost" press="onDownloadResume"/>
				</HBox>
			</VBox>

			<!-- ===== Footer ===== -->
			<HBox class="footer" justifyContent="Center">
				<Text text="{portfolio>/contact/name} — {portfolio>/contact/title}" class="footerText"/>
			</HBox>
		</content>
	</Page>
</mvc:View>